# moyan-mfw 发布配置（个人/开源包，无 scope）
# =========================================
# 下载依赖使用国内镜像源（加速 CI 安装）
registry=https://registry.npmmirror.com

# peer 依赖优先链接 workspace 内的同名包：
# 扩展包对 moyan-mfw-base 的静态 peer 范围（如 ^1.2.0-beta.60）在 base 尚未发布到
# registry 时无法从 registry 解析（发版前的鸡生蛋问题），必须回退到 workspace 链接。
# 仅影响 workspace 内开发与 CI，不影响发布产物（pnpm publish 不改写静态范围）。
link-workspace-packages=true

always_include_source_maps=true
tag=latest
