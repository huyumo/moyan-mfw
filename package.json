{
  "name": "moyan-mfw",
  "version": "1.2.0-beta.59",
  "description": "Moyan backend management framework",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:frontend": "pnpm --filter moyan-mfw-frontend dev",
    "build": "pnpm -r --filter moyan-mfw-base --filter moyan-mfw-cli --filter \"moyan-mfw-extension-*\" build && pnpm run verify:dist",
    "build:frontend": "pnpm --filter moyan-mfw-frontend build",
    "verify:dist": "node scripts/check-dist.mjs && pnpm --filter moyan-mfw-frontend verify-dist",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck:base-shared": "pnpm --filter @internal/base-shared typecheck",
    "typecheck:base-backend": "pnpm --filter @internal/base-backend typecheck",
    "typecheck:base-tests": "pnpm --filter @internal/base-backend typecheck:tests",
    "typecheck:base-frontend": "pnpm --filter @internal/base-frontend typecheck",
    "typecheck:ad-shared": "pnpm --filter @internal/ad-shared typecheck",
    "typecheck:ad-backend": "pnpm --filter @internal/ad-backend typecheck",
    "typecheck:ad-frontend": "pnpm --filter @internal/ad-frontend typecheck",
    "typecheck:ledger-shared": "pnpm --filter @internal/ledger-shared typecheck",
    "typecheck:ledger-backend": "pnpm --filter @internal/ledger-backend typecheck",
    "typecheck:ledger-frontend": "pnpm --filter @internal/ledger-frontend typecheck",
    "typecheck:sms-shared": "pnpm --filter @internal/sms-shared typecheck",
    "typecheck:sms-backend": "pnpm --filter @internal/sms-backend typecheck",
    "typecheck:sms-frontend": "pnpm --filter @internal/sms-frontend typecheck",
    "typecheck:scan-code-shared": "pnpm --filter @internal/scan-code-shared typecheck",
    "typecheck:scan-code-backend": "pnpm --filter @internal/scan-code-backend typecheck",
    "typecheck:scan-code-frontend": "pnpm --filter @internal/scan-code-frontend typecheck",
    "typecheck:vue": "pnpm --filter moyan-mfw-frontend typecheck",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "typecheck:backend": "pnpm --filter moyan-mfw-backend typecheck",
    "typecheck": "pnpm -r --filter moyan-mfw-base --filter moyan-mfw-cli --filter \"moyan-mfw-extension-*\" typecheck && pnpm run typecheck:vue && pnpm run typecheck:backend && pnpm run typecheck:e2e",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json",
    "gen": "plop --plopfile scripts/generators/plopfile.ts",
    "gen:module": "plop --plopfile scripts/generators/plopfile.ts backend-module",
    "gen:page": "plop --plopfile scripts/generators/plopfile.ts frontend-page",
    "gen:component": "plop --plopfile scripts/generators/plopfile.ts frontend-component",
    "validate:skill": "tsx scripts/validate-skill-docs.ts",
    "check:secrets": "bash scripts/check-secrets.sh --ci-push",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "dev:cli": "pnpm --filter moyan-mfw-cli dev",
    "build:cli": "pnpm --filter moyan-mfw-cli build",
    "changesets:gen": "node scripts/gen-changesets.mjs",
    "changesets:status": "changeset status",
    "release": "tsx scripts/release.ts",
    "release:yes": "tsx scripts/release.ts --yes",
    "preenter": "changeset pre enter beta",
    "preexit": "changeset pre exit"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.58.2",
    "@types/jest": "catalog:",
    "@types/node": "^22.19.15",
    "cypress": "^15.12.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.1.9",
    "eslint-plugin-vue": "^10.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "plop": "^4.0.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.46.2",
    "vue-eslint-parser": "^10.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
