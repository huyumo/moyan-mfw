{
  "extends": "../src/backend/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "..",
    "outDir": "../dist-tests",
    "noEmit": true,
    "types": ["bcryptjs", "express", "jest", "multer", "node", "supertest"],
    "typeRoots": [
      "../src/backend/node_modules/@types",
      "../../../node_modules/@types"
    ],
    "paths": {
      "@/*": ["../src/backend/src/*"],
      "*": ["../src/backend/node_modules/*"]
    }
  },
  "include": ["./**/*.ts", "../src/backend/src/**/*.d.ts"]
}
